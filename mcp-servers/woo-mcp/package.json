{
  "name": "woo-mcp",
  "private": true,
  "description": "MCP server (Streamable HTTP, stateless) exposing one WooCommerce store's products and orders",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "^4.28.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
